{
  "name": "ash-workbench",
  "displayName": "ASH Workbench",
  "description": "Automated Security Helper Workbench",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ashWorkbench.mainView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ashWorkbench",
          "title": "ASH Workbench",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ashWorkbench": [
        {
          "type": "webview",
          "id": "ashWorkbench.mainView",
          "name": "Workbench"
        },
        {
          "id": "ashWorkbench.scanHistory",
          "name": "Scan History"
        }
      ]
    },
    "commands": [
      {
        "command": "ashWorkbench.startScan",
        "title": "ASH: Start Scan"
      },
      {
        "command": "ashWorkbench.openWorkbench",
        "title": "ASH: Open Workbench"
      },
      {
        "command": "ashWorkbench.cancelScan",
        "title": "ASH: Cancel Scan"
      },
      {
        "command": "ashWorkbench.openKitchenSink",
        "title": "ASH: Open Kitchen Sink"
      },
      {
        "command": "ashWorkbench.scanFolder",
        "title": "ASH: Run Security Scan"
      },
      {
        "command": "ashWorkbench.deleteScan",
        "title": "ASH: Delete Scan"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ashWorkbench.openWorkbench",
          "when": "view == ashWorkbench.scanHistory",
          "group": "navigation"
        },
        {
          "command": "ashWorkbench.deleteScan",
          "when": "view == ashWorkbench.scanHistory && viewItem =~ /scan\\.(completed|failed|cancelled)/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ashWorkbench.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "ashWorkbench@1"
        }
      ]
    },
    "configuration": {
      "title": "ASH Workbench",
      "properties": {
        "ashWorkbench.ashPath": {
          "type": "string",
          "default": "ash",
          "description": "Path to the ASH CLI executable"
        },
        "ashWorkbench.ashMode": {
          "type": "string",
          "enum": [
            "local",
            "container"
          ],
          "default": "local",
          "description": "ASH execution mode (local or container)"
        },
        "ashWorkbench.scanTimeout": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "description": "Scan timeout in seconds"
        }
      }
    }
  },
  "scripts": {
    "copy:webview": "rm -rf ./webview-dist && cp -r ../webview/dist ./webview-dist",
    "build:webview": "cd ../webview && npm run build && cd ../vsix && npm run copy:webview",
    "vscode:prepublish": "npm run build",
    "build": "npm run build:webview && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@augment-vir/test": "^31.68.1",
    "@electric-sql/pglite": "^0.2.17",
    "@prisma/client": "^7.5.0",
    "@prisma/driver-adapter-utils": "^7.5.0",
    "prisma-pglite": "^2.0.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.0.0",
    "mocha": "^11.0.0",
    "prettier": "^3.5.0",
    "prisma": "^7.5.0",
    "sinon": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
