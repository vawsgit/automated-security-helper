{
  "name": "ash-workbench",
  "displayName": "ASH Workbench",
  "description": "Automated Security Helper Workbench",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ashWorkbench.mainView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ashWorkbench",
          "title": "ASH Workbench",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ashWorkbench": [
        {
          "type": "webview",
          "id": "ashWorkbench.mainView",
          "name": "Workbench"
        },
        {
          "id": "ashWorkbench.scanHistory",
          "name": "Scan History"
        }
      ]
    },
    "commands": [
      {
        "command": "ashWorkbench.startScan",
        "title": "ASH: Start Scan"
      },
      {
        "command": "ashWorkbench.openWorkbench",
        "title": "ASH: Open Workbench"
      },
      {
        "command": "ashWorkbench.cancelScan",
        "title": "ASH: Cancel Scan"
      },
      {
        "command": "ashWorkbench.openKitchenSink",
        "title": "ASH: Open Kitchen Sink"
      },
      {
        "command": "ashWorkbench.deleteScan",
        "title": "ASH: Delete Scan"
      },
      {
        "command": "ashWorkbench.resetApplication",
        "title": "ASH: Reset Application"
      },
      {
        "command": "ashWorkbench.manageSuppressions",
        "title": "ASH: Manage Suppressions"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "ashWorkbench.openWorkbench",
          "when": "view == ashWorkbench.scanHistory",
          "group": "navigation"
        },
        {
          "command": "ashWorkbench.deleteScan",
          "when": "view == ashWorkbench.scanHistory && viewItem =~ /scan\\.(completed|failed|cancelled)/",
          "group": "navigation"
        }
      ],
      "explorer/context": []
    },
    "configuration": {
      "title": "ASH Workbench",
      "properties": {
        "ashWorkbench.scanRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Root directory for ASH scans and findings. Leave empty to use the workspace root."
        },
        "ashWorkbench.ashPath": {
          "type": "string",
          "default": "ash",
          "description": "Path to the ASH CLI executable"
        },
        "ashWorkbench.ashMode": {
          "type": "string",
          "enum": [
            "local",
            "container"
          ],
          "default": "local",
          "description": "ASH execution mode (local or container)"
        },
        "ashWorkbench.scanTimeout": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "description": "Scan timeout in seconds"
        },
        "ashWorkbench.defaultSeverityThreshold": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ],
          "default": "LOW",
          "description": "Default severity threshold for filtering scan results"
        },
        "ashWorkbench.llm.provider": {
          "type": "string",
          "enum": [
            "bedrock",
            "anthropic-api"
          ],
          "default": "",
          "description": "LLM provider for AI-assisted analysis. Leave empty to inherit from Claude Code settings."
        },
        "ashWorkbench.llm.region": {
          "type": "string",
          "default": "",
          "description": "AWS region for LLM provider. Leave empty to inherit from Claude Code settings."
        },
        "ashWorkbench.llm.modelId": {
          "type": "string",
          "default": "",
          "description": "LLM model identifier. Leave empty to inherit from Claude Code settings."
        },
        "ashWorkbench.llm.useClaudeSettings": {
          "type": "boolean",
          "default": true,
          "description": "Inherit LLM configuration from Claude Code settings (~/.claude/settings.json). When true, provider/region/model settings above act as overrides only."
        },
        "ashWorkbench.llm.maxBudgetUsd": {
          "type": "number",
          "default": 1.00,
          "minimum": 0.01,
          "description": "Maximum cost in USD allowed per AI analysis."
        },
        "ashWorkbench.llm.toolMode": {
          "type": "string",
          "enum": [
            "read-only",
            "full"
          ],
          "default": "read-only",
          "description": "Tool access level for AI analysis. 'read-only' allows file reading and searching only. 'full' also allows file editing and shell commands."
        },
        "ashWorkbench.llm.awsProfile": {
          "type": "string",
          "default": "",
          "description": "AWS profile name for LLM provider. Leave empty to inherit from Claude Code settings."
        },
        "ashWorkbench.llm.awsAuthRefresh": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Shell command to refresh AWS credentials. Leave empty to inherit from Claude Code settings. Restricted to user settings only for security."
        },
        "ashWorkbench.llm.maxTurns": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum reasoning iterations per AI analysis."
        },
        "ashWorkbench.llm.batchConsecutiveFailureLimit": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum consecutive analysis failures before stopping batch processing. Resets to zero after each successful analysis."
        }
      }
    }
  },
  "scripts": {
    "copy:webview": "rm -rf ./webview-dist && cp -r ../webview/dist ./webview-dist",
    "build:webview": "cd ../webview && npm run build && cd ../vsix && npm run copy:webview",
    "vscode:prepublish": "npm run build",
    "build": "npm run build:webview && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.80",
    "@augment-vir/test": "^31.68.1",
    "@electric-sql/pglite": "^0.2.17",
    "@prisma/client": "^7.5.0",
    "@prisma/driver-adapter-utils": "^7.5.0",
    "js-yaml": "^4.1.1",
    "picomatch": "^4.0.3",
    "prisma-pglite": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/picomatch": "^4.0.2",
    "@types/sinon": "^17.0.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.0.0",
    "mocha": "^11.0.0",
    "prettier": "^3.5.0",
    "prisma": "^7.5.0",
    "sinon": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
